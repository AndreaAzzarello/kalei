<Project Sdk="Microsoft.NET.Sdk">

  <!-- THROWAWAY spike for ticket 01 (W1-W4). Not part of the product. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SandboxSpike.Launcher</AssemblyName>
    <RootNamespace>SandboxSpike.Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.7" />
  </ItemGroup>

</Project>
