<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AotWindow.MainWindow"
        Title="Kalei AOT spike" Width="640" Height="420" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <TextBlock Text="kalei" FontSize="36" FontWeight="SemiBold" />
    <Border Grid.Row="1" Margin="0,16" CornerRadius="16" BorderThickness="2" BorderBrush="#6C5FF1">
      <TextBlock x:Name="Info" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Drop a file here" />
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <Button x:Name="Go" Content="Convert" />
      <ComboBox x:Name="Targets" SelectedIndex="0" Width="140" />
    </StackPanel>
  </Grid>
</Window>
